<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    app:cardBackgroundColor="?attr/colorSurfaceContainer" app:cardCornerRadius="@dimen/stats_card_corner_radius"
    app:cardElevation="0dp" app:strokeColor="?attr/colorOutlineVariant" app:strokeWidth="1dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:baselineAligned="false" android:paddingVertical="16dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:paddingHorizontal="12dp">
            <androidx.appcompat.widget.AppCompatTextView android:id="@+id/currentStreakText" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:drawableStart="@drawable/baseline_local_fire_department_24"
                android:drawablePadding="10dp" android:gravity="center_vertical"
                app:drawableTint="?attr/colorPrimary" android:textColor="?attr/colorOnSurface"
                android:textSize="26sp" android:textStyle="bold" tools:text="4" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:text="@string/current_streak"
                android:textColor="?android:textColorSecondary" android:textSize="12sp" />
        </LinearLayout>
        <View android:layout_width="1dp" android:layout_height="match_parent"
            android:background="?attr/colorOutlineVariant" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:paddingHorizontal="12dp">
            <androidx.appcompat.widget.AppCompatTextView android:id="@+id/longestStreakText" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:drawableStart="@drawable/baseline_emoji_events_24"
                android:drawablePadding="10dp" android:gravity="center_vertical"
                app:drawableTint="?attr/colorPrimary" android:textColor="?attr/colorOnSurface"
                android:textSize="26sp" android:textStyle="bold" tools:text="12" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:text="@string/longest_streak"
                android:textColor="?android:textColorSecondary" android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
